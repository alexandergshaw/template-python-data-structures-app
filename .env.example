FLASK_APP=run.py
FLASK_DEBUG=1
APP_ENV=development
SECRET_KEY=change-me

# Single-student personalization — shown across the site
STUDENT_NAME=Your Name
STUDENT_TAGLINE=Student developer building things I'm proud of.
STUDENT_BIO=I'm a student developer using this portfolio to share the projects I've built, the things I'm learning, and the ideas I'm exploring.
STUDENT_CONTACT_EMAIL=hello@example.com

# Path to the JSON file that lists every project to display.
# Defaults to data/projects.json at the repository root.
PROJECTS_JSON_PATH=data/projects.json
